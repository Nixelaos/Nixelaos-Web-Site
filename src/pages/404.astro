---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { Home, ArrowLeft } from 'lucide-react';
---

<Layout
  title="404 - Página no encontrada | Nixelaos Tech"
  description="La página que busca no existe o ha sido trasladada."
  theme="light"
>
  <Navbar theme="light" />
  
  <main class="flex-grow flex items-center justify-center py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-xl w-full text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-50 border border-cyan-200 text-cyan-700 text-xs font-semibold tracking-wider uppercase mb-6">
        Error 404
      </div>

      <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">
        Página no encontrada
      </h1>

      <p class="text-slate-600 text-base sm:text-lg mb-8 leading-relaxed">
        El enlace que intentó abrir no existe, cambió de ubicación o se encuentra temporalmente fuera de servicio.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl text-sm font-semibold text-white bg-gradient-to-r from-cyan-600 to-blue-600 hover:from-cyan-500 hover:to-blue-500 shadow-md shadow-cyan-500/20 transition-all active:scale-[0.98]"
        >
          <Home className="w-4 h-4" />
          <span>Volver al Inicio</span>
        </a>

        <a
          href="/servicios"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl text-sm font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 border border-slate-200 transition-all active:scale-[0.98]"
        >
          <ArrowLeft className="w-4 h-4" />
          <span>Ver Servicios</span>
        </a>
      </div>
    </div>
  </main>

  <Footer theme="light" />
</Layout>
