---
import { ArrowUpRight, Menu, X } from 'lucide-react';
import BioNeuralLogo from './BioNeuralLogo.astro';

interface Props {
  theme?: 'dark' | 'light';
}

const { theme = 'dark' } = Astro.props;
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/servicios', label: 'Servicios' },
  { href: '/proceso', label: 'Metodología' },
  { href: '/tecnologias', label: 'Tecnologías' },
  { href: '/contacto', label: 'Contacto' },
];

const isActive = (href: string) => {
  if (href === '/') {
    return currentPath === '/' || currentPath === '';
  }
  return currentPath.startsWith(href);
};
---

<header class={`sticky top-0 z-50 backdrop-blur-md transition-colors duration-200 ${
  theme === 'light'
    ? 'bg-white/90 border-b border-slate-200 shadow-xs'
    : 'bg-[#030d1a]/85 border-b border-cyan-950/80 shadow-lg shadow-cyan-950/20'
}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Logo Corporativo Oficial Bio-Neuronal (SVG Vectorial) -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500 rounded-lg p-1" aria-label="Nixelaos Tech Inicio">
        <div class={`relative w-11 h-11 flex items-center justify-center p-0.5 rounded-xl border transition-colors shadow-inner ${
          theme === 'light'
            ? 'bg-slate-100/80 border-slate-200 group-hover:border-cyan-500/50'
            : 'bg-cyan-950/40 border-cyan-800/40 group-hover:border-cyan-500/50'
        }`}>
          <BioNeuralLogo size="w-9 h-9" animate={true} />
        </div>
        <div class="flex flex-col">
          <span class={`text-xl font-bold tracking-tight transition-colors font-mono ${
            theme === 'light' ? 'text-slate-900 group-hover:text-cyan-600' : 'text-white group-hover:text-cyan-400'
          }`}>
            NIXELAOS<span class="text-cyan-500">.</span>
          </span>
          <span class="text-[10px] uppercase tracking-widest font-semibold text-cyan-600/90 -mt-1">
            IT Solutions
          </span>
        </div>
      </a>

      <!-- Navegación Desktop -->
      <nav class="hidden md:flex items-center gap-8" aria-label="Navegación principal">
        {navLinks.map((link) => {
          const active = isActive(link.href);
          return (
            <a
              href={link.href}
              class={`text-sm transition-colors duration-150 focus:outline-none focus-visible:text-cyan-500 relative py-1 ${
                active
                  ? (theme === 'light' ? 'font-semibold text-cyan-600' : 'font-semibold text-cyan-400')
                  : (theme === 'light' ? 'font-medium text-slate-600 hover:text-cyan-600' : 'font-medium text-slate-300 hover:text-cyan-300')
              }`}
            >
              {link.label}
              {active && (
                <span class="absolute bottom-0 left-0 right-0 h-0.5 bg-gradient-to-r from-cyan-400 to-blue-500 rounded-full shadow-[0_0_8px_rgba(0,245,255,0.8)]"></span>
              )}
            </a>
          );
        })}
      </nav>

      <!-- Botón CTA Desktop -->
      <div class="hidden md:flex items-center gap-4">
        <a
          href="/contacto"
          class="relative inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg text-sm font-semibold text-white bg-gradient-to-r from-cyan-500 via-blue-600 to-indigo-600 hover:from-cyan-400 hover:to-blue-500 shadow-md shadow-cyan-500/20 hover:shadow-cyan-500/40 transition-all duration-200 active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400"
        >
          <span>Agendar Diagnóstico</span>
          <ArrowUpRight className="w-4 h-4 text-white/95" />
        </a>
      </div>

      <!-- Botón Menú Móvil (Zero-React) -->
      <div class="flex md:hidden">
        <button
          id="mobile-menu-button"
          type="button"
          class={`p-2 rounded-lg transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500 ${
            theme === 'light'
              ? 'text-slate-700 hover:text-slate-900 hover:bg-slate-100 border border-slate-200'
              : 'text-slate-300 hover:text-white hover:bg-cyan-950/60 border border-cyan-900/60'
          }`}
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Abrir menú de navegación"
        >
          <span class="sr-only">Abrir menú principal</span>
          <div id="icon-menu-open">
            <Menu className="w-6 h-6" />
          </div>
          <div id="icon-menu-close" class="hidden">
            <X className="w-6 h-6" />
          </div>
        </button>
      </div>

    </div>
  </div>

  <!-- Panel Menú Móvil -->
  <div
    id="mobile-menu"
    class={`hidden md:hidden border-b backdrop-blur-xl px-4 pt-3 pb-6 transition-all duration-200 shadow-xl ${
      theme === 'light'
        ? 'border-slate-200 bg-white/95 text-slate-800'
        : 'border-cyan-950 bg-[#030d1a]/95 text-slate-100'
    }`}
  >
    <div class="flex flex-col space-y-3">
      {navLinks.map((link) => {
        const active = isActive(link.href);
        return (
          <a
            href={link.href}
            class={`mobile-nav-link block px-3 py-2.5 rounded-md text-base transition-colors ${
              active
                ? (theme === 'light' ? 'font-semibold text-cyan-600 bg-cyan-50' : 'font-semibold text-cyan-400 bg-cyan-950/50')
                : (theme === 'light' ? 'font-medium text-slate-700 hover:text-cyan-600 hover:bg-slate-50' : 'font-medium text-slate-300 hover:text-cyan-300 hover:bg-cyan-950/30')
            }`}
          >
            {link.label}
          </a>
        );
      })}
      <div class={`pt-3 border-t ${theme === 'light' ? 'border-slate-200' : 'border-cyan-950'}`}>
        <a
          href="/contacto"
          class="mobile-nav-link flex items-center justify-center gap-2 w-full px-4 py-3 rounded-lg text-center font-semibold text-white bg-gradient-to-r from-cyan-500 via-blue-600 to-indigo-600 hover:from-cyan-400 hover:to-blue-500 shadow-md shadow-cyan-500/20 text-sm transition-all"
        >
          <span>Agendar Diagnóstico</span>
          <ArrowUpRight className="w-4 h-4" />
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const button = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('icon-menu-open');
    const iconClose = document.getElementById('icon-menu-close');
    const links = document.querySelectorAll('.mobile-nav-link');

    if (!button || !menu || !iconOpen || !iconClose) return;

    function toggleMenu() {
      const isExpanded = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    }

    button.addEventListener('click', toggleMenu);

    links.forEach((link) => {
      link.addEventListener('click', () => {
        if (!menu.classList.contains('hidden')) {
          toggleMenu();
        }
      });
    });
  })();
</script>
