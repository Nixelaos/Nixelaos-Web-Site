---
import { ArrowRight, ShieldCheck, Cpu, Headphones, ChevronRight } from 'lucide-react';
import BioNeuralHybrid from './BioNeuralHybrid.astro';
---

<section class="relative overflow-hidden pt-8 pb-16 md:pt-12 md:pb-24 bg-transparent">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Distribución en 2 Columnas: Figura Bio-Electrónica Híbrida a la IZQUIERDA -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 xl:gap-12 items-center">
      
      <!-- COLUMNA IZQUIERDA: Interfaz Bio-Electrónica Híbrida (SVG + Canvas 2D) -->
      <div class="lg:col-span-5 flex justify-center lg:justify-start order-1">
        <div class="relative w-full max-w-[480px] flex justify-center lg:justify-start">
          <BioNeuralHybrid size="w-72 h-72 sm:w-[420px] sm:h-[420px] lg:w-[470px] lg:h-[470px]" />
        </div>
      </div>

      <!-- COLUMNA DERECHA: Contenido Principal, Titular y Acciones B2B -->
      <div class="lg:col-span-7 flex flex-col items-center lg:items-start text-center lg:text-left order-2">
        

        <!-- Título H1 Contundente con Gradiente Eléctrico -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-5xl xl:text-6xl font-extrabold tracking-tight text-slate-900 leading-[1.08] mb-5">
          Escalabilidad, eficiencia y <br class="hidden sm:inline" />
          <span class="bg-gradient-to-r from-cyan-600 via-sky-500 to-blue-600 bg-clip-text text-transparent">
            continuidad operativa
          </span>
          para su empresa
        </h1>

        <!-- Subtítulo Claro y Persuasivo -->
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed mb-8 max-w-xl font-normal">
          Diseñamos arquitecturas en la nube, desarrollamos software a medida y blindamos la infraestructura crítica de su organización para acelerar su crecimiento con cero tiempo de inactividad.
        </p>

        <!-- Botones de Acción (CTA) con Alto Contraste -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mb-10 w-full sm:w-auto">
          <a
            href="/contacto"
            class="inline-flex items-center justify-center gap-2.5 px-8 py-3.5 rounded-xl text-base font-semibold text-white bg-gradient-to-r from-cyan-500 via-sky-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 shadow-lg shadow-cyan-500/25 hover:shadow-cyan-400/40 transition-all duration-200 active:scale-[0.98] group"
          >
            <span>Cotizar Proyecto</span>
            <ArrowRight className="w-5 h-5 text-white group-hover:translate-x-1 transition-transform" />
          </a>

          <a
            href="/servicios"
            class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl text-base font-medium text-slate-700 hover:text-slate-900 bg-white hover:bg-slate-50 border border-slate-200 shadow-xs hover:border-cyan-400/60 transition-all duration-200"
          >
            <span>Explorar Servicios</span>
            <ChevronRight className="w-4 h-4 text-cyan-600 group-hover:translate-x-0.5 transition-transform" />
          </a>
        </div>

        <!-- Fila: 3 Métricas Clave o Garantías Empresariales -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-6 border-t border-slate-200/90 w-full">
          
          <div class="flex items-center gap-3 p-3.5 rounded-xl bg-white/95 border border-slate-200 shadow-xs hover:border-cyan-400/50 transition-all">
            <div class="w-10 h-10 rounded-lg bg-cyan-50 border border-cyan-200/80 flex items-center justify-center shrink-0">
              <ShieldCheck className="w-5 h-5 text-cyan-600" />
            </div>
            <div class="text-left">
              <div class="text-sm font-bold text-slate-900 tracking-tight">99.9% Uptime</div>
              <div class="text-[11px] text-slate-500 font-medium">Continuidad en Cloud</div>
            </div>
          </div>

          <div class="flex items-center gap-3 p-3.5 rounded-xl bg-white/95 border border-slate-200 shadow-xs hover:border-cyan-400/50 transition-all">
            <div class="w-10 h-10 rounded-lg bg-cyan-50 border border-cyan-200/80 flex items-center justify-center shrink-0">
              <Cpu className="w-5 h-5 text-cyan-600" />
            </div>
            <div class="text-left">
              <div class="text-sm font-bold text-slate-900 tracking-tight">Arquitectura a Medida</div>
              <div class="text-[11px] text-slate-500 font-medium">Software sin deuda técnica</div>
            </div>
          </div>

          <div class="flex items-center gap-3 p-3.5 rounded-xl bg-white/95 border border-slate-200 shadow-xs hover:border-cyan-400/50 transition-all">
            <div class="w-10 h-10 rounded-lg bg-cyan-50 border border-cyan-200/80 flex items-center justify-center shrink-0">
              <Headphones className="w-5 h-5 text-cyan-600" />
            </div>
            <div class="text-left">
              <div class="text-sm font-bold text-slate-900 tracking-tight">Soporte Dedicado</div>
              <div class="text-[11px] text-slate-500 font-medium">Ingenieros Senior asignados</div>
            </div>
          </div>

        </div>

      </div>

    </div>
  </div>
</section>
