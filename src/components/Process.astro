---
import { Search, Layers, Terminal, Rocket, Check } from 'lucide-react';

const steps = [
  {
    step: '01',
    icon: Search,
    title: 'Levantamiento y Diagnóstico',
    description: 'Auditamos su infraestructura actual, flujos de datos y requerimientos de negocio para detectar cuellos de botella y riesgos operativos.',
    tags: ['Auditoría Técnica', 'Benchmark de Rendimiento', 'Alcance Funcional']
  },
  {
    step: '02',
    icon: Layers,
    title: 'Propuesta y Arquitectura',
    description: 'Diseñamos una arquitectura tecnológica robusta, seleccionando el stack idóneo, estimación de costos y cronogramas con entregables claros.',
    tags: ['Blueprint de Arquitectura', 'Plan de Mitigación', 'SLAs Definidos']
  },
  {
    step: '03',
    icon: Terminal,
    title: 'Desarrollo e Implementación',
    description: 'Ejecutamos en sprints ágiles con código limpio, pruebas de seguridad, integración continua y revisiones periódicas con su equipo.',
    tags: ['CI/CD Pipelines', 'QA Automatizado', 'Entregas Iterativas']
  },
  {
    step: '04',
    icon: Rocket,
    title: 'Puesta en Marcha y Soporte',
    description: 'Realizamos el despliegue a producción con cero tiempo de inactividad, monitoreo preventivo en tiempo real y soporte técnico especializado.',
    tags: ['Despliegue Cero Downtime', 'Monitoreo 24/7', 'Mantenimiento Evolutivo']
  }
];
---

<section id="proceso" class="py-12 md:py-20 bg-transparent relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Contenedor de Pasos Horizontales -->
    <div class="relative">
      
      <!-- Línea conectora horizontal para pantallas grandes -->
      <div class="hidden lg:block absolute top-1/2 left-0 right-0 h-0.5 bg-gradient-to-r from-cyan-900/40 via-cyan-500/40 to-cyan-900/40 -translate-y-12 z-0"></div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-6 relative z-10">
        {steps.map((item) => {
          const StepIcon = item.icon;
          return (
            <div class="bg-[#091a32]/75 border border-cyan-950/80 rounded-2xl p-6 hover:border-cyan-500/50 hover:bg-[#0c2340]/90 hover:shadow-xl hover:shadow-cyan-950/50 transition-all duration-300 flex flex-col justify-between group shadow-md backdrop-blur-md">
              <div>
                <!-- Badge de Número y Icono -->
                <div class="flex items-center justify-between mb-6">
                  <div class="w-12 h-12 rounded-xl bg-cyan-950/80 border border-cyan-800/60 flex items-center justify-center text-cyan-400 font-mono font-black text-lg group-hover:border-cyan-400 group-hover:text-cyan-300 transition-colors shadow-inner">
                    {item.step}
                  </div>
                  <div class="w-10 h-10 rounded-lg bg-cyan-950/60 border border-cyan-800/50 flex items-center justify-center text-cyan-400 group-hover:bg-cyan-500 group-hover:text-black transition-colors">
                    <StepIcon className="w-5 h-5" />
                  </div>
                </div>

                <!-- Título del Paso -->
                <h3 class="text-lg font-bold text-white mb-2.5 group-hover:text-cyan-400 transition-colors">
                  {item.title}
                </h3>

                <!-- Descripción -->
                <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-6">
                  {item.description}
                </p>
              </div>

              <!-- Tags del paso -->
              <div class="pt-4 border-t border-cyan-950/80 space-y-1.5">
                {item.tags.map((tag) => (
                  <div class="flex items-center gap-2 text-xs text-slate-300">
                    <Check className="w-3.5 h-3.5 text-cyan-400 shrink-0" />
                    <span>{tag}</span>
                  </div>
                ))}
              </div>
            </div>
          );
        })}
      </div>

    </div>

  </div>
</section>
