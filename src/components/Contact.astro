---
import { Mail, MapPin, Clock, Send, CheckCircle } from 'lucide-react';
---

<section id="contacto" class="py-12 md:py-16 bg-transparent relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      
      <!-- Columna Izquierda: Información de Contacto y Propuesta de Valor -->
      <div class="lg:col-span-5 flex flex-col justify-between">
        <div>
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-cyan-950/60 border border-cyan-800/60 text-cyan-300 text-xs font-semibold uppercase tracking-wider mb-4 shadow-inner">
            Iniciemos una Conversación
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight mb-6 leading-tight">
            Impulse la Infraestructura de su Empresa <br />
            <span class="bg-gradient-to-r from-cyan-400 via-sky-300 to-blue-400 bg-clip-text text-transparent">
              con Expertos en TI
            </span>
          </h2>
          <p class="text-slate-300 text-base leading-relaxed mb-8">
            Ya sea que necesite una auditoría técnica inmediata, modernizar sus servidores o construir software empresarial desde cero, nuestro equipo de ingenieros senior está listo para asesorarle.
          </p>

          <!-- Datos de Contacto Directo con Iconos -->
          <div class="space-y-5 mb-10">
            <div class="flex items-start gap-4">
              <div class="w-11 h-11 rounded-xl bg-cyan-950/70 border border-cyan-800/60 flex items-center justify-center text-cyan-400 shrink-0 shadow-inner">
                <Mail className="w-5 h-5" />
              </div>
              <div>
                <span class="text-xs uppercase tracking-wider text-slate-400 font-semibold block">Correo Corporativo</span>
                <a href="mailto:contacto@nixelaos.com" class="text-white hover:text-cyan-400 font-medium transition-colors">
                  contacto@nixelaos.com
                </a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-11 h-11 rounded-xl bg-cyan-950/70 border border-cyan-800/60 flex items-center justify-center text-cyan-400 shrink-0 shadow-inner">
                <MapPin className="w-5 h-5" />
              </div>
              <div>
                <span class="text-xs uppercase tracking-wider text-slate-400 font-semibold block">Ubicación y Cobertura</span>
                <span class="text-slate-200 font-medium">
                  Santiago, Chile — Operaciones Remotas para Latinoamérica y Global
                </span>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-11 h-11 rounded-xl bg-cyan-950/70 border border-cyan-800/60 flex items-center justify-center text-cyan-400 shrink-0 shadow-inner">
                <Clock className="w-5 h-5" />
              </div>
              <div>
                <span class="text-xs uppercase tracking-wider text-slate-400 font-semibold block">Horario de Atención</span>
                <span class="text-slate-200 font-medium">
                  Lunes a Viernes: 09:00 - 18:00 (Soporte Crítico 24/7 para clientes con SLA)
                </span>
              </div>
            </div>
          </div>
        </div>

        <!-- Garantías de Confidencialidad -->
        <div class="p-4 rounded-xl bg-[#091a32]/75 border border-cyan-950/80 space-y-2 shadow-md">
          <div class="flex items-center gap-2 text-xs font-semibold text-slate-300">
            <CheckCircle className="w-4 h-4 text-cyan-400" />
            <span>SLA de respuesta garantizado en menos de 24 horas laborables.</span>
          </div>
          <div class="flex items-center gap-2 text-xs font-semibold text-slate-300">
            <CheckCircle className="w-4 h-4 text-cyan-400" />
            <span>Firmamos Acuerdo de Confidencialidad (NDA) antes de cualquier análisis.</span>
          </div>
        </div>
      </div>

      <!-- Columna Derecha: Formulario HTML Semántico Elegante en Azul Marino -->
      <div class="lg:col-span-7">
        <div class="bg-[#091a32]/85 border border-cyan-950/90 rounded-2xl p-6 sm:p-8 md:p-10 shadow-2xl shadow-cyan-950/40 backdrop-blur-md">
          <h3 class="text-xl font-bold text-white mb-2">
            Solicitar Diagnóstico o Cotización
          </h3>
          <p class="text-sm text-slate-300 mb-8">
            Complete el siguiente formulario y un consultor técnico evaluará sus requerimientos.
          </p>

          <form action="#" method="POST" class="space-y-6">
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <!-- Nombre -->
              <div>
                <label for="nombre" class="block text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-2">
                  Nombre Completo <span class="text-cyan-400">*</span>
                </label>
                <input
                  type="text"
                  id="nombre"
                  name="nombre"
                  required
                  placeholder="Ej. Rodrigo Morales"
                  class="w-full bg-[#051122]/90 border border-cyan-950/90 rounded-lg px-4 py-3 text-sm text-white placeholder-slate-500 focus:bg-[#07162b] focus:outline-none focus:ring-2 focus:ring-cyan-500/30 focus:border-cyan-400 transition-all shadow-inner"
                />
              </div>

              <!-- Empresa -->
              <div>
                <label for="empresa" class="block text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-2">
                  Empresa / Organización <span class="text-cyan-400">*</span>
                </label>
                <input
                  type="text"
                  id="empresa"
                  name="empresa"
                  required
                  placeholder="Ej. Inversiones Global SpA"
                  class="w-full bg-[#051122]/90 border border-cyan-950/90 rounded-lg px-4 py-3 text-sm text-white placeholder-slate-500 focus:bg-[#07162b] focus:outline-none focus:ring-2 focus:ring-cyan-500/30 focus:border-cyan-400 transition-all shadow-inner"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <!-- Correo Corporativo -->
              <div>
                <label for="email" class="block text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-2">
                  Correo Corporativo <span class="text-cyan-400">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="nombre@empresa.com"
                  class="w-full bg-[#051122]/90 border border-cyan-950/90 rounded-lg px-4 py-3 text-sm text-white placeholder-slate-500 focus:bg-[#07162b] focus:outline-none focus:ring-2 focus:ring-cyan-500/30 focus:border-cyan-400 transition-all shadow-inner"
                />
              </div>

              <!-- Selector de Servicio de Interés -->
              <div>
                <label for="servicio" class="block text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-2">
                  Servicio de Interés <span class="text-cyan-400">*</span>
                </label>
                <select
                  id="servicio"
                  name="servicio"
                  required
                  class="w-full bg-[#051122]/90 border border-cyan-950/90 rounded-lg px-4 py-3 text-sm text-white focus:bg-[#07162b] focus:outline-none focus:ring-2 focus:ring-cyan-500/30 focus:border-cyan-400 transition-all cursor-pointer shadow-inner"
                >
                  <option value="" disabled selected class="text-slate-500">Seleccione una opción...</option>
                  <option value="desarrollo" class="bg-[#051122] text-white">Desarrollo de Software y Web Apps</option>
                  <option value="cloud" class="bg-[#051122] text-white">Infraestructura Cloud & DevOps</option>
                  <option value="database" class="bg-[#051122] text-white">Optimización de Bases de Datos</option>
                  <option value="soporte" class="bg-[#051122] text-white">Soporte Técnico, Redes y Servidores</option>
                  <option value="automatizacion" class="bg-[#051122] text-white">Automatización e Integración de APIs/ERPs</option>
                  <option value="seguridad" class="bg-[#051122] text-white">Auditoría de Seguridad y Respaldo</option>
                  <option value="otro" class="bg-[#051122] text-white">Consultoría TI Integral / Varios</option>
                </select>
              </div>
            </div>

            <!-- Mensaje -->
            <div>
              <label for="mensaje" class="block text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-2">
                Descripción del Proyecto o Necesidad <span class="text-cyan-400">*</span>
              </label>
              <textarea
                id="mensaje"
                name="mensaje"
                rows="4"
                required
                placeholder="Describa brevemente el estado actual de su infraestructura, volumen de usuarios, o la solución que desea implementar..."
                class="w-full bg-[#051122]/90 border border-cyan-950/90 rounded-lg px-4 py-3 text-sm text-white placeholder-slate-500 focus:bg-[#07162b] focus:outline-none focus:ring-2 focus:ring-cyan-500/30 focus:border-cyan-400 transition-all resize-y shadow-inner"
              ></textarea>
            </div>

            <!-- Botón de Envío -->
            <button
              type="submit"
              class="w-full inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl text-sm sm:text-base font-semibold text-black bg-gradient-to-r from-cyan-400 via-sky-300 to-cyan-400 hover:from-cyan-300 hover:to-white shadow-xl shadow-cyan-500/25 hover:shadow-cyan-400/40 transition-all duration-200 active:scale-[0.99] cursor-pointer font-medium"
            >
              <span>Enviar Solicitud de Diagnóstico</span>
              <Send className="w-4 h-4 text-black" />
            </button>

            <p class="text-center text-xs text-slate-400">
              Garantizamos estricta confidencialidad de su información corporativa. Cero spam.
            </p>

          </form>
        </div>
      </div>

    </div>
  </div>
</section>
